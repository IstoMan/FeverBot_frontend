{
  "name": "FeverBot (Flutter)",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "flutter-web",
      "command": "export PATH=\"$HOME/flutter/bin:$PATH\" && flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080"
    }
  ],
  "ports": [
    {
      "name": "FeverBot web",
      "port": 8080
    }
  ]
}
